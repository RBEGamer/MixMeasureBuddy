	(text "MixMeasureBuddy carrier board - Raspberry Pi Pico 2 W"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "21e11ce0-c733-5f5a-af2b-d0e736db43fa")
	)
	(text "Pin mapping = src/firmware/src/config.py (OLED I2C0 GP16/17, buttons GP3/GP2, HX711 GP4/GP5,\nencoder GP20/19/18, WS2812 GP28, SD SPI1 GP8-11). Buttons use the internal pull-ups."
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "82764124-0d60-5914-91c0-abb2f25240c7")
	)
	(text "HX711: VSUP=VSYS, DVDD=3V3 (3.3 V logic).\nAVDD = 1.25 V x (R1+R2)/R2 = 3.75 V, E- tied to AGND,\nRATE=GND -> 10 SPS, internal oscillator (XI=GND)."
		(exclude_from_sim no)
		(at 190.5 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "be36707d-2371-5bab-9d9c-3d3d87e65768")
	)
	(text "Load cell: J4 1=A+ (green) 2=A- (white) 3=E- (black) 4=E+ (red)"
		(exclude_from_sim no)
		(at 190.5 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dfb74db7-8e4a-53ef-8f84-86be57892165")
	)
	(text "OPTIONAL LiPo: MCP73831 charger (500 mA), Q2/D1 load sharing, J8 power switch,\nMT3608 boost to 5.1 V OR-ed into VSYS through D3. VBAT/2 on GP26 (ADC0)."
		(exclude_from_sim no)
		(at 25.4 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "51500f75-8e0c-59cd-aab1-e85e5d296dbb")
	)
